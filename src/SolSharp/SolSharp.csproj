<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>SolSharp</PackageId>
    <IsPackable>true</IsPackable>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>3.0.0</PackageValidationBaselineVersion>
    <Description>A contract-driven, Native AOT-ready .NET 10 SDK for Solana — independently implemented from pinned Anza Solana SDK, Agave, and SPL source contracts. Source-generated JSON with no reflection; typed RPC and multiplexed WebSocket streaming; Ed25519 and BLS12-381 keys/signatures; program instructions and bounded state decoding; and exact legacy/v0/V1 transaction wire formats verified against Rust-compatible vectors. Ships as one package bundling the Core, Wallet, Rpc, and Programs functional assemblies plus a minimal packaging facade.</Description>
    <PackageReleaseNotes>3.1.0 — correctness, hardening, and performance. Fixes Token-2022 CreateNativeMint, which named the classic wSOL mint and could never succeed, and the SlotHashes/StakeHistory decoders, which rejected the canonical zero-padded sysvar account on any cluster whose 512-entry ring was not yet full. PublicKey.IsOnCurve is 39x faster (309us -> 7.8us), taking PDA/ATA derivation from 642us to 18us; 32-byte base58 encode and PublicKey/Hash parsing use a fixed-width codec (parse 1.18us -> 0.25us, allocation-free). Base58 parsing is length-bounded before decoding, so a hostile 200,000-character string is rejected immediately instead of costing ~24s. Adds Mints.Token2022NativeMint, MaxBase58Length constants, and length-bounded Base58 overloads. WebSocket subscriptions gained configurable wire-byte budgets. Wire output is unchanged and verified byte-for-byte against the pinned Rust sources. Full details: https://github.com/jecacs/SolSharp/blob/v3.1.0/CHANGELOG.md</PackageReleaseNotes>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);BundleProjectReferences</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SolSharp.Core/SolSharp.Core.csproj" PrivateAssets="all"/>
    <ProjectReference Include="../SolSharp.Wallet/SolSharp.Wallet.csproj" PrivateAssets="all"/>
    <ProjectReference Include="../SolSharp.Rpc/SolSharp.Rpc.csproj" PrivateAssets="all"/>
    <ProjectReference Include="../SolSharp.Programs/SolSharp.Programs.csproj" PrivateAssets="all"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SimpleBase" Version="5.6.4"/>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0"/>
    <PackageReference Include="Nethermind.Crypto.Bls" Version="1.1.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- Remove this exclusion after the first net10.0 release becomes the package-validation baseline. -->
    <PackageValidationBaselineFrameworkToIgnore Include="net8.0" />
  </ItemGroup>

  <Target Name="BundleProjectReferences" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <_BundledProjectReference Include="@(ReferenceCopyLocalPaths->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))"/>
      <BuildOutputInPackage Include="@(_BundledProjectReference)"/>
      <BuildOutputInPackage Include="@(_BundledProjectReference->'%(RootDir)%(Directory)%(Filename).xml')"/>
    </ItemGroup>
  </Target>

</Project>
