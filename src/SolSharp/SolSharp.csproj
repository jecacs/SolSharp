<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>SolSharp</PackageId>
    <IsPackable>true</IsPackable>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>3.2.0</PackageValidationBaselineVersion>
    <Description>A contract-driven, Native AOT-ready .NET 10 SDK for Solana — independently implemented from pinned Anza Solana SDK, Agave, and SPL source contracts. Source-generated JSON with no reflection; typed RPC and multiplexed WebSocket streaming; Ed25519 and BLS12-381 keys/signatures; program instructions and bounded state decoding; and exact legacy/v0/V1 transaction wire formats verified against Rust-compatible vectors. Ships as one package bundling the Core, Wallet, Rpc, and Programs functional assemblies plus a minimal packaging facade.</Description>
    <PackageReleaseNotes>4.0.0 — V1 transactions by default. Breaking change: HTTP transaction/block reads and WebSocket block subscriptions now advertise transaction version 1; full configuration objects also default MaxSupportedTransactionVersion to 1. Use explicit version 0 to retain legacy/v0-only reads, or null in full options to omit the version field. Base58/binary encodings require an explicit version 0 or null; use base64, JSON, or jsonParsed for V1. Adds GetTransactionOptions.MinContextSlot and GetSignatureStatusesWithOptionsAsync with history, commitment, and minimum-context-slot options. Updates NuGet dependencies and the pinned .NET 10 toolchain, fixes the SourceLink security-audit failure, and synchronizes solution, benchmark, and packed AOT locks. Verified with default V1 HTTP/WebSocket tests, a read-only mainnet V1 regression, and packed Native AOT smoke checks. Full details: https://github.com/jecacs/SolSharp/blob/v4.0.0/CHANGELOG.md</PackageReleaseNotes>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);BundleProjectReferences</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SolSharp.Core/SolSharp.Core.csproj" PrivateAssets="all"/>
    <ProjectReference Include="../SolSharp.Wallet/SolSharp.Wallet.csproj" PrivateAssets="all"/>
    <ProjectReference Include="../SolSharp.Rpc/SolSharp.Rpc.csproj" PrivateAssets="all"/>
    <ProjectReference Include="../SolSharp.Programs/SolSharp.Programs.csproj" PrivateAssets="all"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SimpleBase" Version="5.6.4"/>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0"/>
    <PackageReference Include="Nethermind.Crypto.Bls" Version="1.1.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <Target Name="BundleProjectReferences" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <_BundledProjectReference Include="@(ReferenceCopyLocalPaths->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))"/>
      <BuildOutputInPackage Include="@(_BundledProjectReference)"/>
      <BuildOutputInPackage Include="@(_BundledProjectReference->'%(RootDir)%(Directory)%(Filename).xml')"/>
    </ItemGroup>
  </Target>

</Project>
