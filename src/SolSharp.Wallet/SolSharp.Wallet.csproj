<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Strict Ed25519 and BLS12-381 keys/signatures for Solana on .NET: secure import/export, local/external/offline signers, signed off-chain messages, BIP-39/SLIP-0010 derivation, Vote proofs of possession, and PoP-gated same-message aggregation over vetted crypto backends.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Nethermind.Crypto.Bls" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SolSharp.Wallet.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SolSharp.Core/SolSharp.Core.csproj" />
  </ItemGroup>

</Project>
