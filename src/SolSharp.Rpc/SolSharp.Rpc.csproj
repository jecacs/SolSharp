<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Typed Solana JSON-RPC and PubSub for .NET: bounded HTTP reads/send/simulate/batching, multiplexed reconnecting WebSocket subscriptions, source-generated JSON, and resilient DI registration.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SolSharp.Rpc.Tests" />
    <!-- The benchmark harness compares the source-generated pipeline (RpcJson) against reflection. -->
    <InternalsVisibleTo Include="SolSharp.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SolSharp.Core/SolSharp.Core.csproj" />
  </ItemGroup>

</Project>
