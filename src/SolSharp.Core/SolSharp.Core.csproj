<Project Sdk="Microsoft.NET.Sdk">

<PropertyGroup>
  <TargetFramework>net10.0</TargetFramework>
  <ImplicitUsings>enable</ImplicitUsings>
  <Nullable>enable</Nullable>
  <IsAotCompatible>true</IsAotCompatible>
  <Description>Core Solana primitives for .NET: distinct PublicKey and Hash values, base58, compact-u16 and bounded Borsh encoding, commitment levels, source-generated JSON, well-known addresses, and bounded current sysvar-state decoders. No I/O or crypto engine.</Description>
</PropertyGroup>

<ItemGroup>
  <PackageReference Include="SimpleBase" Version="5.6.4" />
</ItemGroup>

</Project>
