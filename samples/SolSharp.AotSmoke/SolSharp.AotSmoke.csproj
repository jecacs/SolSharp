<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <PublishAotUsingRuntimePack>true</PublishAotUsingRuntimePack>
    <UseDefaultPublishRuntimeIdentifier>false</UseDefaultPublishRuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UsePackedSolSharp)' == 'true'">
    <NuGetLockFilePath>$(BaseIntermediateOutputPath)packages.packed.lock.json</NuGetLockFilePath>
  </PropertyGroup>

  <ItemGroup Condition="'$(UsePackedSolSharp)' != 'true'">
    <ProjectReference Include="../../src/SolSharp.Core/SolSharp.Core.csproj" />
    <ProjectReference Include="../../src/SolSharp.Wallet/SolSharp.Wallet.csproj" />
    <ProjectReference Include="../../src/SolSharp.Rpc/SolSharp.Rpc.csproj" />
    <ProjectReference Include="../../src/SolSharp.Programs/SolSharp.Programs.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UsePackedSolSharp)' == 'true'">
    <PackageReference Include="SolSharp" Version="$(SolSharpPackageVersion)" />
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.301" />
  </ItemGroup>

</Project>
