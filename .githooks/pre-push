#!/usr/bin/env bash
# Runs the core local CI gates before anything leaves the machine.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Skip for one push:       git push --no-verify      (or SOLSHARP_SKIP_PREPUSH=1 git push)
# Skip only the tests:     SOLSHARP_PREPUSH_SKIP_TESTS=1 git push
#
# The checks are ordered cheapest-first and use the same flags as their .github/workflows/ci.yml
# counterparts. CI additionally enforces coverage, documentation consistency, package/API validation,
# and the Native AOT consumer smoke. The local flags remain deliberate:
#   --severity info   is the solution gate (CA1859 and friends are info-level and do fail CI)
#   --severity warn   is the benchmarks gate, deliberately lower (see the note in ci.yml)
#   --locked-mode     catches a packages.lock.json that drifted from the projects
set -euo pipefail

if [[ -n "${SOLSHARP_SKIP_PREPUSH:-}" ]]; then
  echo "pre-push: skipped via SOLSHARP_SKIP_PREPUSH."
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "${repo_root}"

# A push that only deletes refs has nothing to verify.
only_deletes=1
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [[ -z "${local_sha:-}" ]] && continue
  [[ "${local_sha}" =~ ^0+$ ]] || only_deletes=0
done
if [[ "${only_deletes}" -eq 1 ]]; then
  echo "pre-push: deletion-only push, nothing to verify."
  exit 0
fi

# global.json pins one exact SDK, and a GUI-launched IDE does not inherit a shell's PATH, so the pinned SDK
# is often reachable only from a side-by-side install. Look there before giving up, otherwise pushing from
# Rider fails while the identical push from a terminal succeeds.
pinned_sdk="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' global.json | head -1)"

resolves_to_pin() {
  [[ -x "$1" ]] && [[ "$("$1" --version 2>/dev/null)" == "${pinned_sdk}" ]]
}

dotnet_root=""
if ! resolves_to_pin "$(command -v dotnet 2>/dev/null)"; then
  for candidate in "${DOTNET_ROOT:-}" "${HOME}/.dotnet" /usr/share/dotnet /usr/lib/dotnet /usr/local/share/dotnet; do
    [[ -n "${candidate}" ]] || continue
    if resolves_to_pin "${candidate}/dotnet"; then
      dotnet_root="${candidate}"
      break
    fi
  done

  if [[ -z "${dotnet_root}" ]]; then
    echo "pre-push: global.json pins SDK ${pinned_sdk}, and no dotnet on PATH or in a known install root provides it." >&2
    echo "pre-push: the pin is required because IsAotCompatible/PublishAot record SDK-versioned packages in" >&2
    echo "pre-push: packages.lock.json, so any other SDK fails the locked restore." >&2
    echo "pre-push:   curl -sSL https://dot.net/v1/dotnet-install.sh | bash -s -- --version ${pinned_sdk}" >&2
    exit 1
  fi

  export DOTNET_ROOT="${dotnet_root}"
  export PATH="${dotnet_root}:${PATH}"
  echo "pre-push: using SDK ${pinned_sdk} from ${dotnet_root} (not on PATH)."
fi

benchmarks="benchmarks/SolSharp.Benchmarks/SolSharp.Benchmarks.csproj"
step=0
run() {
  step=$((step + 1))
  local label="$1"
  shift
  printf 'pre-push [%d] %s ... ' "${step}" "${label}"
  local output
  if output="$("$@" 2>&1)"; then
    printf 'ok\n'
  else
    printf 'FAILED\n\n'
    printf '%s\n' "${output}" | tail -40
    printf '\npre-push: "%s" failed. Fix it, or push with --no-verify if you know why.\n' "${label}" >&2
    exit 1
  fi
}

# Restore first: a lock file that drifted from the projects is the cheapest failure to surface, and the
# solution restore does not cover benchmarks/, which lives outside SolSharp.sln.
run "restore (locked)"            dotnet restore --locked-mode -p:NuGetAuditMode=all -warnaserror
run "restore benchmarks (locked)" dotnet restore "${benchmarks}" --locked-mode -p:NuGetAuditMode=all -warnaserror
run "build"                       dotnet build --no-restore --configuration Release -warnaserror
run "build benchmarks"            dotnet build "${benchmarks}" --no-restore --configuration Release -warnaserror
run "format"                      dotnet format --no-restore --verify-no-changes --severity info
run "format benchmarks"           dotnet format "${benchmarks}" --no-restore --verify-no-changes --severity warn

if [[ -n "${SOLSHARP_PREPUSH_SKIP_TESTS:-}" ]]; then
  echo "pre-push: tests skipped via SOLSHARP_PREPUSH_SKIP_TESTS."
else
  run "tests (offline)" dotnet test --no-build --configuration Release --filter "TestCategory!=Integration"
fi

echo "pre-push: all checks passed."
